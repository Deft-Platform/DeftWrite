{
  "name": "deftwrite",
  "private": true,
  "workspaces": ["packages/*", "server", "web"],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:all": "concurrently -n server,web -c blue,magenta 'bun --filter server dev' 'bun --filter web dev'",
    "db:generate": "bun --filter @deftwrite/db db:generate",
    "db:migrate": "bun --filter @deftwrite/db db:migrate",
    "db:studio": "bun --filter @deftwrite/db db:studio",
    "db:push": "bun --filter @deftwrite/db db:push",
    "typecheck": "bun --filter @deftwrite/* typecheck",
    "test": "bun --filter @deftwrite/* test",
    "lint": "bun --filter @deftwrite/* lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
